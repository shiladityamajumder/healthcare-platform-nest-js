NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
API_PREFIX=api
API_VERSION=1
DOCS_ENABLED=true
DATABASE_ENABLED=true

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=healthcare
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# * Optional: full PostgreSQL URL. When set, it takes precedence over the fields above.
# * DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_ENDPOINT_ID=
DATABASE_POOL_SIZE=20

MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=healthcare
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=healthcare
REDIS_DEFAULT_TTL_SECONDS=300

CORS_ORIGINS=http://localhost:3001
TRUST_PROXY=false
LOG_LEVEL=info

JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
