# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
APP_NAME=Healthcare Platform API
APP_VERSION=1.0.0
TIMEZONE=Asia/Kolkata
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SHUTDOWN_TIMEOUT_MS=10000

# =============================================================================
# HTTP API
# =============================================================================
API_PREFIX=api
API_VERSION=1
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3001
CORS_ALLOW_CREDENTIALS=false
MAX_REQUEST_BODY_BYTES=2097152
SECURE_HEADERS_ENABLED=true
HSTS_ENABLED=false
TRUST_PROXY=false
# TRUSTED_PROXY_IPS=10.0.0.0/8,127.0.0.1

# =============================================================================
# LOGGING AND HEALTH
# =============================================================================
LOG_LEVEL=info
LOG_JSON=false
LOG_TO_FILE=false
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
LOG_QUEUE_SIZE=10000
SENSITIVE_DATA_REDACTION_ENABLED=true
SLOW_REQUEST_THRESHOLD_MS=1000
HEALTHCHECK_TIMEOUT_MS=3000
DEEP_HEALTH_ENABLED=true

# =============================================================================
# DATABASE
# DATABASE_ENABLED=false disables all database clients and allows the API to
# start. Database-backed endpoints must report that persistence is unavailable.
# =============================================================================
DATABASE_ENABLED=true
POSTGRES_ENABLED=true
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=healthcare
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Optional full PostgreSQL URL. It takes precedence over the fields above.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_ENDPOINT_ID=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_COMMAND_TIMEOUT_MS=15000

# MongoDB is optional and independently controlled.
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=healthcare
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=15000
MONGO_RETRY_READS=true
MONGO_RETRY_WRITES=true

# =============================================================================
# CACHE
# REDIS_ENABLED=false keeps the Redis client disabled. Cache-backed endpoints
# must report that the optional cache dependency is unavailable.
# =============================================================================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=healthcare
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# =============================================================================
# AUTHENTICATION
# AUTH_ENABLED=false stops authentication-specific startup requirements. Do
# not use it in a deployment that exposes protected routes.
# =============================================================================
AUTH_ENABLED=true
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_PASSWORD_RESET_SECRET=replace-me
# JWT_SECRET is supported as a compatibility fallback for all JWT secrets.
# JWT_SECRET=replace-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
JWT_ISSUER=healthcare-platform
JWT_AUDIENCE=healthcare-platform
AUTH_PEPPER=replace-me-with-a-long-auth-pepper
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_REQUIRED=true
PHONE_VERIFICATION_REQUIRED=true
DEFAULT_ROLE_CODE=customer
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_RESEND_WINDOW_SECONDS=3600
OTP_DEV_EXPOSE_CODE=false
